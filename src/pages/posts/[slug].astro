---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 上一篇 / 下一篇（按发布日期排序后的相邻条目）
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const index = allPosts.findIndex((p) => p.id === post.id);
const prev = allPosts[index + 1];
const next = allPosts[index - 1];

const formattedDate = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PostLayout title={post.data.title} description={post.data.summary} headings={headings}>
  <header class="post-header">
    <h1>{post.data.title}</h1>
    <div class="post-meta">
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      <span>{post.data.categories}</span>
      {
        post.data.tags.map((tag) => (
          <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
        ))
      }
    </div>
  </header>

  <div class="prose">
    <Content />
  </div>

  <nav class="post-pagination" aria-label="文章导航">
    {
      prev && (
        <a href={`/posts/${prev.id}/`}>← {prev.data.title}</a>
      )
    }
    {
      next && (
        <a href={`/posts/${next.id}/`}>{next.data.title} →</a>
      )
    }
  </nav>
</PostLayout>
