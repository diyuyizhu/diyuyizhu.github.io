---
const { pathname } = Astro.url;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
---

<header class="site-header">
  <a class="site-name" href="/" aria-label="回到首页">diyuyizhu<span>'s Blog</span></a>
  <nav class="site-nav" aria-label="主导航">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={pathname === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
