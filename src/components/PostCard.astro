---
import TagChip from './TagChip.astro';
import type { CollectionEntry } from 'astro:content';

type Post = CollectionEntry<'blog'>;

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, summary, pubDate, categories, tags } = post.data;
const formattedDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card">
  <a class="post-card__link" href={`/posts/${post.id}/`}>
    <div class="post-card__meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <span class="post-card__category">{categories}</span>
    </div>
    <h2 class="post-card__title">{title}</h2>
    <p class="post-card__summary">{summary}</p>
    <div class="post-card__tags">
      {tags.map((tag) => <TagChip tag={tag} />)}
    </div>
  </a>
</article>
